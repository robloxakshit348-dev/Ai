# Copy to .env for local use (export the variables or use: node --env-file=.env server.js)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional spare keys, comma-separated (used when the first is out of credits / rate-limited)
OPENROUTER_API_KEYS=
# Free models, tried in order
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
OPENROUTER_CODE_MODELS=
# Leave empty for free "Image Prompt Studio" mode
OPENROUTER_IMAGE_MODEL=
DAILY_FREE_MESSAGES=30
PORT=3000

# Keyless backup AI used when OpenRouter has no key / no credits (true/false)
KEYLESS_FALLBACK=true
